# Laundry OMS — Backend Configuration
# Copy this file to .env and adjust values for your environment.

# Database connection string
DATABASE_URL=postgres://laundry:laundry_secret@localhost:5432/laundry_oms?sslmode=disable

# HTTP server port
PORT=8080

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Authentication secret (generate with: openssl rand -hex 32)
AUTH_SECRET=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Rate limiting (requests per second, burst)
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Migrations directory (relative to binary)
MIGRATIONS_DIR=migrations
