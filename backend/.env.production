# ============================================================
# Laundry OMS — Backend Production Environment
# Set these as Render environment variables or .env file.
# NEVER commit real secrets to git.
# ============================================================

# Database connection (SSL required in production)
DATABASE_URL=postgres://laundry:__DB_PASSWORD__@__DB_HOST__:5432/laundry_oms?sslmode=require&pool_min_conns=2&pool_max_conns=20

# HTTP server port (Render sets this automatically)
PORT=8080

# Allowed CORS origins (comma-separated for production)
CORS_ORIGINS=https://laundry.example.com,https://www.laundry.example.com

# Authentication secret (generate with: openssl rand -hex 32)
AUTH_SECRET=__GENERATE_OPENSSL_RAND_HEX_32__

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Rate limiting (requests per second, burst)
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Migrations directory (relative to binary)
MIGRATIONS_DIR=migrations
